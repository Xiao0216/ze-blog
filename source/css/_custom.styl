.site-info-card
  margin: .35rem 0
  padding: .15rem 0
  > div
    display: flex
    align-items: center
    justify-content: space-between
    gap: .5rem
    min-height: 1.52rem
    padding: .14rem .05rem
    border-bottom: 1px dashed var(--block-border)
    &:last-child
      border-bottom: 0
    > dt
      flex: 0 0 auto
      margin: 0
      color: var(--text-p3)
      font-size: .72rem
      line-height: 1.2
      white-space: nowrap
    > dd
      flex: 1 1 auto
      min-width: 0
      margin: 0
      color: var(--text-p1)
      font-size: .76rem
      font-weight: 700
      line-height: 1.2
      text-align: right
      white-space: nowrap
      overflow: hidden
      text-overflow: ellipsis
